---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import readyToCutRibbon from '../assets/images/about/ready-to-cut-ribbon.jpg';
import mayorAndRiders from '../assets/images/about/mayor-and-riders.jpg';
import newsAtSchool from '../assets/images/about/news-at-school.jpg';
---

<Layout title="About — Bike On NZ" description="Bike On New Zealand Charitable Trust (CC44779) was founded in 2010 to help more New Zealanders experience the joys and benefits of riding a bike.">
  <section class="container-page flex flex-wrap items-center gap-12 py-[clamp(2.5rem,7vw,4rem)]">
    <div class="flex min-w-0 flex-[1_1_26rem] flex-col gap-6">
      <h1 class="h-hero">About Bikes in Schools</h1>
      <p class="lead">
        Bike On New Zealand Charitable Trust (CC44779) was founded in 2010 with a simple aim: help more New Zealanders experience the joys and benefits of riding a bike.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/guide/introduction" class="btn">Read the guide</a>
        <a href="/contact" class="btn btn-secondary">Get in touch</a>
      </div>
    </div>
    <div class="grid min-w-0 flex-[1_1_24rem] grid-cols-5 grid-rows-2 gap-3 md:gap-4">
      <Image
        src={readyToCutRibbon}
        alt="Children ready to cut the ribbon"
        width={420}
        height={430}
        fit="cover"
        priority
        class="col-span-3 row-span-2 h-full w-full rounded-2xl object-cover"
      />
      <Image
        src={mayorAndRiders}
        alt="Mayor and children with bikes"
        width={280}
        height={210}
        fit="cover"
        loading="eager"
        class="col-span-2 aspect-[4/3] h-full w-full rounded-2xl object-cover"
      />
      <Image
        src={newsAtSchool}
        alt="School bike event in the news"
        width={280}
        height={210}
        fit="cover"
        loading="eager"
        class="col-span-2 aspect-[4/3] h-full w-full rounded-2xl object-cover"
      />
    </div>
  </section>

  <section class="bg-tint">
    <div class="container-page section flex flex-wrap gap-12">
      <div class="flex min-w-0 flex-[1_1_24rem] flex-col gap-4">
        <h2 class="h2">Our vision</h2>
        <p class="copy">
          Regular and equal access to bikes and bike tracks within the school environment for all New
          Zealand school children.
        </p>
        <p class="copy">
          Children should not need to own a bike, have parents who cycle, or live in a particular
          neighbourhood to experience riding. A bike, a helmet, and a safe place to ride are there for
          every student.
        </p>
      </div>
      <div class="flex min-w-0 flex-[1_1_24rem] flex-col gap-4">
        <h2 class="h2">What we do</h2>
        <p class="copy">
          We offer free, hands-on advice to any school or council in New Zealand keen to set up a Bikes
          in Schools project, covering everything from project management to funding to getting it
          built.
        </p>
        <p class="copy">
          Our <a href="/guide/introduction" target="_blank" rel="noopener">free guide</a> draws on what we've learned working with
          schools right across the country. It walks through the what, why, and how of setting up a
          Bikes in Schools project at any school.
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <a href="/guide/introduction" class="btn">Read the guide</a>
          <a href="https://www.youtube.com/@bikesinschoolsnz" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <Icon name="tabler:brand-youtube" class="h-5 w-5" /> YouTube
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page section flex flex-wrap items-center gap-12">
    <div class="flex min-w-0 flex-[1_1_24rem] flex-col gap-4">
      <h2 class="h2">Bikes in Schools in action</h2>
      <p class="copy">
        Bikes in Schools is a complete biking package built within a school so every student can ride
        on a regular basis. The school owns a fleet of 30 to 50 bikes in four sizes, a helmet for
        every child, on-site tracks, secure storage, and cycle skills training.
      </p>
    </div>
    <div class="min-w-0 flex-[1_1_24rem]">
      <div class="aspect-video overflow-hidden rounded-2xl bg-tint">
        <iframe
          class="h-full w-full"
          src="https://www.youtube.com/embed/LTdJk0JgVJA"
          title="Bikes in Schools in action"
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <section class="container-page pb-[var(--section)]">
    <div class="border-t border-border pt-[var(--section)]">
      <div class="flex flex-col gap-4">
        <h2 class="h2">The impact</h2>
        <p class="lead">
          Regular access to riding a bike goes from around 30% of students to 100%. That impact is
          immediate and measurable.
        </p>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-12">
        <div>
          <h3 class="h3">What schools tell us</h3>
          <p class="copy mt-2">
            Feedback from principals, teachers, parents, and students consistently shows that riding
            builds confidence, self-esteem, and resilience. Children get fitter, gain skills, and start
            using a bike for everyday transport. Families often ride more together too.
          </p>
        </div>
        <div>
          <h3 class="h3">Independent research</h3>
          <p class="copy mt-2">
            Independent research by the Eastern Institute of Technology tracked three schools over two
            years. Teachers reported increased fitness, motor skills, and coordination. The percentage
            of overweight children dropped, against the national trend.
          </p>
        </div>
        <div>
          <h3 class="h3">ACC report, 2019</h3>
          <p class="copy mt-2">
            In 2019, Mackie Research released a report commissioned by ACC titled <em>Fun, Active, Safe
            and Social</em>. It confirmed positive outcomes across health, skills, and participation.
          </p>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="/map" class="btn">View the map</a>
        <p class="copy">
          See every school with a Bikes in Schools project across Aotearoa, 400+ and counting.
        </p>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
