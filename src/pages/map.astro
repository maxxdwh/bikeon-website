---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import HeroSection from '../components/HeroSection.astro';
import schools from '../data/schools.json';

const regions = [...new Set(schools.map((s) => s.region))].sort();
---

<Layout title="Map of Schools — Bike On NZ" description="See where Bikes in Schools projects are across New Zealand.">
  <HeroSection
    title="Map of Schools"
    description={`${schools.length}+ schools across New Zealand with a Bikes in Schools project. Search by name, filter by region, or pan the map to see what's nearby.`}
  />

  <section class="container-page page-end pt-4">
    <div class="grid gap-4 lg:grid-cols-[20rem_1fr]">
      <div class="space-y-3">
        <div class="relative">
          <Icon name="tabler:search" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
          <label for="school-search" class="sr-only">Search school name</label>
          <input
            type="search"
            id="school-search"
            placeholder="Search school name..."
            class="field pl-10"
          />
        </div>
        <div class="relative">
          <label for="region-filter" class="sr-only">Filter by region</label>
          <select
            id="region-filter"
            class="field appearance-none pr-10"
          >
            <option value="all">All regions</option>
            {regions.map((region) => (
              <option value={region}>{region}</option>
            ))}
          </select>
          <Icon name="tabler:chevron-down" class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
        </div>
        <div class="flex items-center justify-between text-base text-muted-foreground">
          <span id="school-count">{schools.length} schools</span>
          <button id="reset-search" class="hidden cursor-pointer font-semibold text-link underline hover:text-ink">Show all schools</button>
        </div>
      </div>

      <div class="min-h-[400px] overflow-hidden rounded-xl bg-tint lg:row-span-2 lg:min-h-[600px]">
        <div id="map" style="height: 100%; width: 100%; min-height: 400px;"></div>
      </div>

      <div class="max-h-[400px] overflow-y-auto border-y border-line lg:max-h-[600px]">
        <ul id="school-list" class="divide-y divide-line-soft">
          {schools.map((school, i) => (
            <li
              class="school-item flex cursor-pointer items-start gap-3 px-2 py-3 transition-colors hover:bg-tint-2 focus-visible:-outline-offset-2"
              tabindex="0"
              role="button"
              aria-label={`Focus ${school.name} on the map`}
              data-name={school.name.toLowerCase()}
              data-region={school.region}
              data-lat={school.lat}
              data-lng={school.lng}
              data-index={i}
            >
              <div class="mt-1 shrink-0 text-primary">
                <Icon name="tabler:map-pin" class="h-4 w-4" />
              </div>
              <div class="min-w-0">
                <p class="truncate text-base font-semibold">{school.name}</p>
                <p class="meta truncate">{school.town}, {school.region}</p>
              </div>
            </li>
          ))}
        </ul>
        <p id="no-results" class="hidden p-6 text-center text-base text-muted-foreground">
          No schools found. Try a different search or clear your filters.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ schools }}>
  let map;
  let markers = [];
  let infoWindow;
  let searchInput;
  let regionFilter;
  let listItems;
  let countLabel;
  let resetBtn;
  let noResults;
  let schoolFocused = false;
  const defaultCenter = { lat: -40.9006, lng: 174.886 };
  const defaultZoom = 6;

  function initMap() {
    const center = { lat: -40.9006, lng: 174.886 };
    map = new google.maps.Map(document.getElementById('map'), {
      zoom: 6,
      center,
      mapTypeControl: false,
      streetViewControl: false,
      fullscreenControl: true,
    });
    infoWindow = new google.maps.InfoWindow();

    schools.forEach((school, i) => {
      const marker = new google.maps.Marker({
        position: { lat: school.lat, lng: school.lng },
        map,
        title: school.name,
      });
      marker.addListener('click', () => {
        openInfoWindow(i);
      });
      markers.push({ marker, school, index: i });
    });

    map.addListener('idle', updateListFromMapBounds);
  }

  function openInfoWindow(index) {
    const { marker, school } = markers[index];
    infoWindow.setContent(
      `<div style="padding: 6px 4px;"><strong>${school.name}</strong><br/>${school.town}, ${school.region}</div>`
    );
    infoWindow.open(map, marker);
  }

  function focusSchool(index) {
    const { school } = markers[index];
    schoolFocused = true;
    map.panTo({ lat: school.lat, lng: school.lng });
    if (map.getZoom() < 12) map.setZoom(14);
    openInfoWindow(index);
    updateResetButton();
  }

  function normalize(str) {
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[''.']/g, '')
      .replace(/\./g, '')
      .replace(/\bschool\b/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function applyFilters() {
    const query = normalize(searchInput.value);
    const region = regionFilter.value;
    const hasFilters = query !== '' || region !== 'all';

    const matched = [];

    markers.forEach(({ marker, school, index }) => {
      const schoolName = normalize(school.name);
      const nameMatch = query === '' || schoolName.includes(query);
      const regionMatch = region === 'all' || school.region === region;
      const visible = nameMatch && regionMatch;
      marker.setVisible(visible);
      if (visible) matched.push({ school, index });
    });

    updateList(hasFilters);

    if (hasFilters && matched.length > 0) {
      const bounds = new google.maps.LatLngBounds();
      matched.forEach(({ school }) => {
        bounds.extend({ lat: school.lat, lng: school.lng });
      });
      map.fitBounds(bounds, 40);
    }
  }

  function updateList(fromSearch) {
    let visibleCount = 0;

    listItems.forEach((item) => {
      const index = parseInt(item.dataset.index);
      const school = schools[index];
      const query = normalize(searchInput.value);
      const nameMatch = query === '' || normalize(school.name).includes(query);
      const regionMatch = regionFilter.value === 'all' || school.region === regionFilter.value;
      const inView = fromSearch ? true : isInBounds(school);
      const visible = nameMatch && regionMatch && inView;
      item.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    countLabel.textContent = `${visibleCount} school${visibleCount !== 1 ? 's' : ''}`;
    noResults.classList.toggle('hidden', visibleCount > 0);
    updateResetButton();
  }

  function updateListFromMapBounds() {
    if (hasActiveFilters()) return;
    const zoom = map.getZoom();
    const center = map.getCenter();
    const atDefault = zoom <= defaultZoom && center && Math.abs(center.lat() - defaultCenter.lat) < 0.01 && Math.abs(center.lng() - defaultCenter.lng) < 0.01;
    if (atDefault && schoolFocused) {
      schoolFocused = false;
      updateResetButton();
    }
    let visibleCount = 0;
    listItems.forEach((item) => {
      const index = parseInt(item.dataset.index);
      const school = schools[index];
      const inBounds = isInBounds(school);
      item.style.display = inBounds ? '' : 'none';
      if (inBounds) visibleCount++;
    });
    countLabel.textContent = `${visibleCount} school${visibleCount !== 1 ? 's' : ''} in view`;
    noResults.classList.toggle('hidden', visibleCount > 0);
  }

  function isInBounds(school) {
    const bounds = map.getBounds();
    if (!bounds) return true;
    return bounds.contains({ lat: school.lat, lng: school.lng });
  }

  function hasActiveFilters() {
    return searchInput.value.trim() !== '' || regionFilter.value !== 'all';
  }

  function updateResetButton() {
    const show = hasActiveFilters() || schoolFocused;
    resetBtn.classList.toggle('hidden', !show);
  }

  function resetFilters() {
    searchInput.value = '';
    regionFilter.value = 'all';
    schoolFocused = false;
    infoWindow.close();
    applyFilters();
    map.setCenter(defaultCenter);
    map.setZoom(defaultZoom);
    updateResetButton();
  }

  window.initMap = initMap;

  document.addEventListener('DOMContentLoaded', () => {
    searchInput = document.getElementById('school-search');
    regionFilter = document.getElementById('region-filter');
    listItems = document.querySelectorAll('.school-item');
    countLabel = document.getElementById('school-count');
    resetBtn = document.getElementById('reset-search');
    noResults = document.getElementById('no-results');

    let searchTimer;
    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(applyFilters, 200);
    });

    regionFilter.addEventListener('change', applyFilters);

    resetBtn.addEventListener('click', resetFilters);

    listItems.forEach((item) => {
      item.addEventListener('click', () => {
        const index = parseInt(item.dataset.index);
        focusSchool(index);
      });
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const index = parseInt(item.dataset.index);
          focusSchool(index);
        }
      });
    });
  });
</script>

<script
  is:inline
  src={`https://maps.googleapis.com/maps/api/js?key=${import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || 'YOUR_API_KEY'}&callback=initMap`}
  async defer
></script>
