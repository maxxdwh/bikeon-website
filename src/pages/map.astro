---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import HeroSection from '../components/HeroSection.astro';
import schools from '../data/schools.json';

const regions = [...new Set(schools.map((s) => s.region))].sort();
---

<Layout title="Map of Schools — Bike On NZ" description="See where Bikes in Schools projects are across New Zealand.">
  <HeroSection
    title="Map of Schools"
    description={`${schools.length} schools across New Zealand with a Bikes in Schools project. Search by name, filter by region, or pan the map to see what's nearby.`}
  />

  <section class="container-page page-end pt-4">
    <div class="grid gap-4 lg:grid-cols-[20rem_1fr] lg:items-stretch">
      <div class="flex min-h-0 flex-col gap-3 lg:max-h-[600px]">
        <div class="relative">
          <Icon name="tabler:search" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
          <label for="school-search" class="sr-only">Search by school or town</label>
          <input
            type="search"
            id="school-search"
            placeholder="Search school or town…"
            class="field pl-10"
          />
        </div>
        <div class="relative">
          <label for="region-filter" class="sr-only">Filter by region</label>
          <select
            id="region-filter"
            class="field appearance-none pr-10"
          >
            <option value="all">All regions</option>
            {regions.map((region) => (
              <option value={region}>{region}</option>
            ))}
          </select>
          <Icon name="tabler:chevron-down" class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
        </div>
        <div class="flex items-center justify-between text-base text-muted-foreground">
          <span id="school-count" role="status">{schools.length} schools</span>
          <button id="reset-search" class="hidden cursor-pointer font-semibold text-link underline hover:text-ink">Show all schools</button>
        </div>

        <div id="school-list-wrap" class="min-h-0 flex-1 overflow-y-auto border-y border-line max-lg:max-h-[400px]">
          <ul id="school-list" class="divide-y divide-line-soft">
            {schools.map((school, i) => (
              <li
                class="school-item"
                data-name={school.name.toLowerCase()}
                data-town={school.town.toLowerCase()}
                data-region={school.region}
                data-lat={school.lat}
                data-lng={school.lng}
                data-index={i}
              >
                <button
                  type="button"
                  class="flex w-full cursor-pointer items-start gap-3 px-2 py-3 text-left transition-colors hover:bg-tint-2 focus-visible:-outline-offset-2"
                  aria-label={`Focus ${school.name} on the map`}
                >
                  <div class="mt-1 shrink-0 text-primary">
                    <Icon name="tabler:map-pin" class="h-4 w-4" aria-hidden="true" />
                  </div>
                  <div class="min-w-0">
                    <p class="truncate text-base font-semibold">{school.name}</p>
                    <p class="meta truncate">{school.town}, {school.region}</p>
                  </div>
                </button>
              </li>
            ))}
          </ul>
          <p id="no-results" role="status" class="hidden p-6 text-center text-base text-muted-foreground">
            No schools found. Try a different search or clear your filters.
          </p>
        </div>
      </div>

      <div class="min-h-[400px] overflow-hidden rounded-xl bg-tint lg:min-h-[600px]">
        <div id="map" style="height: 100%; width: 100%; min-height: 400px;"></div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  let schools = [];
  const schoolsReady = fetch('/schools.json').then((r) => r.json()).then((data) => (schools = data));
  let map;
  let markers = [];
  let infoWindow;
  let searchInput;
  let regionFilter;
  let listItems;
  let listWrap;
  let countLabel;
  let resetBtn;
  let noResults;
  let schoolFocused = false;
  const defaultCenter = { lat: -40.9006, lng: 174.886 };
  const defaultZoom = 6;

  async function initMap() {
    await schoolsReady;
    const center = { lat: -40.9006, lng: 174.886 };
    map = new google.maps.Map(document.getElementById('map'), {
      zoom: 6,
      center,
      mapTypeControl: false,
      streetViewControl: false,
      fullscreenControl: true,
    });
    infoWindow = new google.maps.InfoWindow();

    schools.forEach((school, i) => {
      const marker = new google.maps.Marker({
        position: { lat: school.lat, lng: school.lng },
        map,
        title: school.name,
      });
      marker.addListener('click', () => {
        openInfoWindow(i);
      });
      markers.push({ marker, school, index: i });
    });

    map.addListener('idle', updateListFromMapBounds);
    if (pendingFocusIndex !== null) {
      const index = pendingFocusIndex;
      pendingFocusIndex = null;
      focusSchool(index);
    }
  }

  function openInfoWindow(index) {
    const { marker, school } = markers[index];
    infoWindow.setContent(
      `<div style="padding: 6px 4px;"><strong>${school.name}</strong><br/>${school.town}, ${school.region}</div>`
    );
    infoWindow.open(map, marker);
  }

  let pendingFocusIndex = null;

  function focusSchool(index) {
    if (!markers.length) {
      pendingFocusIndex = index;
      loadGoogleMapsNow();
      return;
    }
    const { school } = markers[index];
    schoolFocused = true;
    map.panTo({ lat: school.lat, lng: school.lng });
    if (map.getZoom() < 12) map.setZoom(14);
    openInfoWindow(index);
    updateResetButton();
  }

  function normalize(str) {
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[''.']/g, '')
      .replace(/\./g, '')
      .replace(/\bschool\b/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  async function applyFilters() {
    await schoolsReady;
    const query = normalize(searchInput.value);
    const region = regionFilter.value;
    const hasFilters = query !== '' || region !== 'all';

    const matched = [];

    markers.forEach(({ marker, school, index }) => {
      const visible = schoolMatches(school, query, region);
      marker.setVisible(visible);
      if (visible) matched.push({ school, index });
    });

    updateList(hasFilters);

    if (hasFilters && matched.length > 0 && map) {
      const bounds = new google.maps.LatLngBounds();
      matched.forEach(({ school }) => {
        bounds.extend({ lat: school.lat, lng: school.lng });
      });
      map.fitBounds(bounds, 40);
    }
  }

  function schoolMatches(school, query, region) {
    const regionMatch = region === 'all' || school.region === region;
    if (!regionMatch) return false;
    if (query === '') return true;
    return (
      normalize(school.name).includes(query) ||
      normalize(school.town).includes(query)
    );
  }

  function updateList(fromSearch) {
    let visibleCount = 0;
    const query = normalize(searchInput.value);
    const region = regionFilter.value;
    const clipToBounds = !fromSearch && !isOverviewView();

    listItems.forEach((item) => {
      const index = parseInt(item.dataset.index);
      const school = schools[index];
      const inView = clipToBounds ? isInBounds(school) : true;
      const visible = schoolMatches(school, query, region) && inView;
      item.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    if (listWrap) listWrap.scrollTop = 0;
    countLabel.textContent = `${visibleCount} school${visibleCount !== 1 ? 's' : ''}`;
    noResults.classList.toggle('hidden', visibleCount > 0);
    updateResetButton();
  }

  function updateListFromMapBounds() {
    if (hasActiveFilters()) return;
    if (isOverviewView()) {
      if (schoolFocused) {
        schoolFocused = false;
        updateResetButton();
      }
      listItems.forEach((item) => {
        item.style.display = '';
      });
      countLabel.textContent = `${schools.length} schools`;
      noResults.classList.add('hidden');
      return;
    }
    let visibleCount = 0;
    listItems.forEach((item) => {
      const index = parseInt(item.dataset.index);
      const school = schools[index];
      const inBounds = isInBounds(school);
      item.style.display = inBounds ? '' : 'none';
      if (inBounds) visibleCount++;
    });
    countLabel.textContent = `${visibleCount} school${visibleCount !== 1 ? 's' : ''} in view`;
    noResults.classList.toggle('hidden', visibleCount > 0);
  }

  // Country overview still clips Chatham / far-north markers at the tile edge —
  // show the full list until the user zooms in past the default.
  function isOverviewView() {
    if (!map) return true;
    const zoom = map.getZoom();
    return zoom == null || zoom <= defaultZoom + 0.25;
  }

  function isInBounds(school) {
    const bounds = map.getBounds();
    if (!bounds) return true;
    return bounds.contains({ lat: school.lat, lng: school.lng });
  }

  function hasActiveFilters() {
    return searchInput.value.trim() !== '' || regionFilter.value !== 'all';
  }

  function updateResetButton() {
    const show = hasActiveFilters() || schoolFocused;
    resetBtn.classList.toggle('hidden', !show);
  }

  function resetFilters() {
    searchInput.value = '';
    regionFilter.value = 'all';
    schoolFocused = false;
    if (infoWindow) infoWindow.close();
    applyFilters();
    if (map) {
      map.setCenter(defaultCenter);
      map.setZoom(defaultZoom);
    }
    updateResetButton();
  }

  window.initMap = initMap;

  document.addEventListener('DOMContentLoaded', () => {
    searchInput = document.getElementById('school-search');
    regionFilter = document.getElementById('region-filter');
    listItems = document.querySelectorAll('.school-item');
    listWrap = document.getElementById('school-list-wrap');
    countLabel = document.getElementById('school-count');
    resetBtn = document.getElementById('reset-search');
    noResults = document.getElementById('no-results');

    let searchTimer;
    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(applyFilters, 200);
    });

    regionFilter.addEventListener('change', applyFilters);

    resetBtn.addEventListener('click', resetFilters);

    listItems.forEach((item) => {
      item.querySelector('button')?.addEventListener('click', () => {
        const index = parseInt(item.dataset.index);
        focusSchool(index);
      });
    });
  });
</script>

<script is:inline define:vars={{ mapsApiKey: import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || 'YOUR_API_KEY' }}>
  let googleMapsLoaded = false;
  function loadGoogleMapsNow() {
    if (googleMapsLoaded) return;
    googleMapsLoaded = true;
    for (const href of ['https://maps.googleapis.com', 'https://maps.gstatic.com']) {
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = href;
      document.head.appendChild(link);
    }
    const script = document.createElement('script');
    script.src = `https://maps.googleapis.com/maps/api/js?key=${mapsApiKey}&callback=initMap`;
    script.async = true;
    document.head.appendChild(script);
  }
  const mapEl = document.getElementById('map');
  if ('IntersectionObserver' in window && mapEl) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          loadGoogleMapsNow();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(mapEl);
  } else {
    loadGoogleMapsNow();
  }
</script>
