---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import SupplierList from '../../components/SupplierList.astro';
import GuideExport from '../../components/GuideExport.astro';
export async function getStaticPaths() {
  const guides = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);
  return guides.map((guide, i) => ({
    params: { slug: guide.id },
    props: {
      guide,
      prev: i > 0 ? guides[i - 1] : null,
      next: i < guides.length - 1 ? guides[i + 1] : null,
    },
  }));
}

const { guide, prev, next } = Astro.props;
const { Content } = await render(guide);
const allGuides = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);

const supplierCategory = { bikes: 'Bikes', 'bike-storage': 'Bike storage' }[guide.id as string];
---

<Layout
  title={`${guide.data.title} — Bike On NZ`}
  description={guide.data.description}
  schema={{
    '@type': 'Article',
    headline: guide.data.title,
    description: guide.data.description,
    image: new URL(guide.data.heroImage.src, Astro.site).href,
    articleSection: 'The Bikes in Schools guide',
  }}
>
  <nav class="no-print sticky top-[calc(var(--header-h)+1px)] z-40 border-b border-border bg-white" aria-label="Guide sections">
    <div class="container-page">
      <div class="flex gap-x-5 overflow-x-auto font-semibold [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {allGuides.map((g) => (
          <a
            href={`/guide/${g.id}`}
            aria-current={g.id === guide.id ? 'page' : undefined}
            class={`shrink-0 border-b-2 py-3 text-base text-ink no-underline transition-colors ${g.id === guide.id ? 'border-primary' : 'border-transparent hover:border-brand'}`}
          >
            {g.data.title}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <div class="container-page page-top page-end print:w-full print:p-0">
    <div class="flex w-full gap-12 lg:items-start lg:justify-between">
      <div class="w-full min-w-0 max-w-[var(--measure)] print:max-w-none">
        <header class="flex flex-col gap-4">
          <p class="eyebrow">Guide</p>
          <h1 class="h-page">{guide.data.title}</h1>
          <p class="lead">{guide.data.description}</p>
        </header>

        <div class="no-print mt-8 rounded-lg bg-tint-2 px-6 py-5 lg:hidden">
          <p class="mb-3 text-lg font-bold">On this page</p>
          <div id="toc-pills" class="flex flex-col gap-2"></div>
          <GuideExport id="export-inline" />
        </div>

        <Image src={guide.data.heroImage} alt="" width={760} priority class="no-print mt-8 w-full rounded-2xl object-cover" />

        <article class="prose mt-10 print:mt-4 [&_h2]:scroll-mt-40" data-guide-text>
          <Content />

          {supplierCategory && <SupplierList category={supplierCategory} />}
        </article>

        <nav class="no-print mt-16 flex flex-col gap-4 border-t border-line-soft pt-6 sm:grid sm:grid-cols-2" aria-label="Guide navigation">
          {prev ? (
            <a href={`/guide/${prev.id}`} class="panel gap-1">
              <span class="meta flex items-center gap-1">
                <Icon name="tabler:arrow-left" class="h-4 w-4" /> Previous
              </span>
              <span class="text-lg font-bold">{prev.data.title}</span>
            </a>
          ) : <span />}
          {next ? (
            <a href={`/guide/${next.id}`} class="panel items-end gap-1 text-right">
              <span class="meta flex items-center gap-1">
                Next <Icon name="tabler:arrow-right" class="h-4 w-4" />
              </span>
              <span class="text-lg font-bold">{next.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      </div>

      <aside class="no-print hidden shrink-0 self-stretch lg:block" style="width: 260px;">
        <div class="sticky top-40 max-h-[calc(100svh-11rem)] overflow-y-auto rounded-lg bg-tint-2 px-6 py-5">
          <p class="mb-3 text-lg font-bold">On this page</p>
          <ul id="toc-list" class="flex flex-col gap-2"></ul>
          <GuideExport id="export-aside" />
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const article = document.querySelector('article');
  const tocList = document.getElementById('toc-list');
  if (article && tocList) {
    const headings = article.querySelectorAll('h2');
    const tocPills = document.getElementById('toc-pills');
    headings.forEach((h, i) => {
      if (!h.id) h.id = 'heading-' + i;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent;
      a.className = 'toc-link block font-semibold leading-snug no-underline hover:underline';
      li.appendChild(a);
      tocList.appendChild(li);
      if (tocPills) {
        const pill = document.createElement('a');
        pill.href = '#' + h.id;
        pill.textContent = h.textContent;
        pill.className = 'toc-pill block font-semibold leading-snug no-underline hover:underline';
        tocPills.appendChild(pill);
      }
    });

    const tocLinks = tocList.querySelectorAll('.toc-link');
    const tocPillsAll = tocPills ? tocPills.querySelectorAll('.toc-pill') : [];
    let ticking = false;
    function updateActive() {
      let activeIdx = -1;
      headings.forEach((h, i) => {
        const rect = h.getBoundingClientRect();
        if (rect.top <= 180) activeIdx = i;
      });
      [...tocLinks, ...tocPillsAll].forEach((link, i) => {
        link.classList.toggle('text-ink', i % headings.length === activeIdx);
      });
      ticking = false;
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateActive);
      }
    });
    updateActive();
  }
</script>

<script is:inline>
  document.querySelectorAll('article table').forEach((table) => {
    var wrapper = document.createElement('div');
    wrapper.className = 'not-prose no-print mt-2 mb-8 relative hidden lg:block';
    table.parentNode.insertBefore(wrapper, table.nextSibling);

    var btn = document.createElement('button');
    btn.setAttribute('aria-haspopup', 'true');
    btn.setAttribute('aria-expanded', 'false');
    btn.className = 'btn btn-secondary btn-sm';
    var dlIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';
    var chevIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron transition-transform duration-150"><polyline points="6 9 12 15 18 9"/></svg>';
    var btnLabel = 'Download this table';
    btn.innerHTML = dlIcon + ' <span class="btn-text">' + btnLabel + '</span> ' + chevIcon;

    var menu = document.createElement('div');
    menu.setAttribute('role', 'menu');
    menu.className = 'absolute left-0 top-12 z-10 hidden rounded-lg border border-border bg-white p-2 shadow-[0_12px_24px_-12px_rgb(11_31_42/0.25)]';
    var svgWrap = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-muted-foreground">';
    var icons = {
      csv: svgWrap + '<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M5 12V5a2 2 0 0 1 2-2h7l5 5v4M7 16.5a1.5 1.5 0 0 0-3 0v3a1.5 1.5 0 0 0 3 0m3 .75c0 .414.336.75.75.75H12a1 1 0 0 0 1-1v-1a1 1 0 0 0-1-1h-1a1 1 0 0 1-1-1v-1a1 1 0 0 1 1-1h1.25a.75.75 0 0 1 .75.75m3-.75l2 6l2-6"/></svg>',
      xls: svgWrap + '<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M5 12V5a2 2 0 0 1 2-2h7l5 5v4M4 15l4 6m-4 0l4-6m9 5.25c0 .414.336.75.75.75H19a1 1 0 0 0 1-1v-1a1 1 0 0 0-1-1h-1a1 1 0 0 1-1-1v-1a1 1 0 0 1 1-1h1.25a.75.75 0 0 1 .75.75M11 15v6h3"/></svg>',
      pdf: svgWrap + '<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M5 12V5a2 2 0 0 1 2-2h7l5 5v4M5 18h1.5a1.5 1.5 0 0 0 0-3H5v6m12-3h2m1-3h-3v6m-6-6v6h1a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2z"/></svg>'
    };
    var items = [
      { fmt: 'csv', label: 'Download as CSV' },
      { fmt: 'xls', label: 'Download as Excel (XLS)' },
      { fmt: 'pdf', label: 'Download as PDF' }
    ];
    menu.innerHTML = items.map(function(item, i) {
      return '<button role="menuitem" tabindex="-1" class="menu-item flex w-full cursor-pointer items-center gap-2 rounded-sm px-3 py-2 text-left text-base font-semibold whitespace-nowrap hover:bg-tint-2 focus:bg-tint-2 focus:outline-none" data-fmt="' + item.fmt + '">' + icons[item.fmt] + ' ' + item.label + '</button>';
    }).join('');
    wrapper.appendChild(btn);
    wrapper.appendChild(menu);

    var menuItems = menu.querySelectorAll('.menu-item');
    var chevron = btn.querySelector('.chevron');
    var btnText = btn.querySelector('.btn-text');
    var isOpen = false;

    function openMenu() {
      menu.classList.remove('hidden');
      isOpen = true;
      btn.setAttribute('aria-expanded', 'true');
      chevron.style.transform = 'rotate(180deg)';
      menuItems[0].focus();
    }
    function closeMenu() {
      menu.classList.add('hidden');
      isOpen = false;
      btn.setAttribute('aria-expanded', 'false');
      chevron.style.transform = '';
    }

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (isOpen) closeMenu(); else openMenu();
    });
    document.addEventListener('click', function() { if (isOpen) closeMenu(); });
    document.addEventListener('keydown', function(e) {
      if (!isOpen) return;
      if (e.key === 'Escape') { closeMenu(); btn.focus(); }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        var idx = Array.from(menuItems).indexOf(document.activeElement);
        menuItems[(idx + 1) % menuItems.length].focus();
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        var idx = Array.from(menuItems).indexOf(document.activeElement);
        menuItems[(idx - 1 + menuItems.length) % menuItems.length].focus();
      }
    });

    function downloadTable(fmt) {
      var rows = table.querySelectorAll('tr');
      var data = Array.from(rows).map(function(row) {
        return Array.from(row.querySelectorAll('th, td')).map(function(cell) {
          return cell.textContent.trim();
        });
      });
      if (fmt === 'csv') {
        var csv = data.map(function(row) {
          return row.map(function(cell) {
            return '"' + cell.replace(/"/g, '""') + '"';
          }).join(',');
        }).join('\n');
        var blob = new Blob([csv], { type: 'text/csv' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'bikes-in-schools-costs.csv';
        a.click();
        URL.revokeObjectURL(a.href);
      } else if (fmt === 'xls') {
        var xls = data.map(function(row, i) {
          var cells = row.map(function(cell) {
            var tag = i === 0 ? 'th' : 'td';
            return '<' + tag + '>' + cell + '</' + tag + '>';
          }).join('');
          return '<tr>' + cells + '</tr>';
        }).join('');
        var html = '<html><head><meta charset="utf-8"></head><body><table>' + xls + '</table></body></html>';
        var blob = new Blob([html], { type: 'application/vnd.ms-excel' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'bikes-in-schools-costs.xls';
        a.click();
        URL.revokeObjectURL(a.href);
      } else if (fmt === 'pdf') {
        var tbl = data.map(function(row, i) {
          var cells = row.map(function(cell) {
            var tag = i === 0 ? 'th' : 'td';
            return '<' + tag + ' style="border:1px solid #ddd;padding:8px 12px;text-align:left;font-size:14px">' + cell + '</' + tag + '>';
          }).join('');
          return '<tr>' + cells + '</tr>';
        }).join('');
        var printWin = window.open('', '_blank');
        printWin.document.write('<html><head><title>Typical costs for Bikes in Schools</title><style>body{font-family:system-ui,sans-serif;padding:2rem}h1{font-size:18px;margin-bottom:0}h2{font-size:13px;font-weight:400;color:#666;margin-bottom:1.5rem}table{border-collapse:collapse;width:100%}th{font-weight:600;background:#f5f5f5}</style></head><body><h1>Typical costs for Bikes in Schools</h1><h2>bikeon.org.nz</h2><table>' + tbl + '</table></body></html>');
        printWin.document.close();
        printWin.focus();
        setTimeout(function() { printWin.print(); }, 250);
      }
    }

    menuItems.forEach(function(item) {
      item.addEventListener('click', function() {
        downloadTable(item.getAttribute('data-fmt'));
        closeMenu();
        btnText.textContent = 'Downloaded!';
        setTimeout(function() {
          btnText.textContent = btnLabel;
        }, 1500);
      });
    });
  });
</script>

<style is:global>
  @page {
    margin: 14mm 15mm;
  }
</style>
