---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import { Image } from 'astro:assets';
import royalOak from '../assets/images/about/royal-oak-opening.jpg';
---

<Layout title="Contact — Bike On NZ" description="Get in touch with Bike On NZ about starting a Bikes in Schools project.">
  <HeroSection
    title="Get in touch"
    description="Got a question about starting a Bikes in Schools project, or want to talk through what it'd take at your school? Get in touch, we're happy to help."
  />

  <section class="container-page page-end pt-4">
    <div class="grid gap-12 md:grid-cols-2">
      <div class="space-y-8">
        <div>
          <h2 class="h3">Email</h2>
          <p class="mt-2">
            <a href="mailto:info@bikeon.org.nz">info@bikeon.org.nz</a>
          </p>
        </div>
        <div>
          <h2 class="h3">Postal address</h2>
          <p class="copy mt-2">
            Bike On NZ Charitable Trust<br />
            PO Box 13009<br />
            Hastings, New Zealand
          </p>
        </div>
        <Image
          src={royalOak}
          alt="Bikes in Schools opening event at Royal Oak School"
          width={580}
          class="mt-8 w-full rounded-2xl object-cover"
        />
      </div>

      <div>
        <form id="contact-form" class="space-y-5 rounded-2xl bg-tint-2 p-6 md:p-8" method="POST" action="/api/contact">
          <div>
            <label for="name" class="block text-base font-bold">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="field mt-1.5"
            />
          </div>
          <div>
            <label for="email" class="block text-base font-bold">Email address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="field mt-1.5"
            />
          </div>
          <div>
            <label for="message" class="block text-base font-bold">Your message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="field mt-1.5"
            ></textarea>
          </div>
          <div id="turnstile-container" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "YOUR_SITE_KEY"}></div>
          <button type="submit" class="btn">
            Send message
          </button>
          <p id="form-success" class="hidden rounded-md bg-green-50 p-4 text-base font-semibold text-green-800">
            Your message has been received! We'll get back to you soon.
          </p>
          <p id="form-error" class="hidden rounded-md bg-red-50 p-4 text-base font-semibold text-red-800">
            That didn't work. Please try again.
          </p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  window.onTurnstileLoad = function () {
    var container = document.getElementById('turnstile-container');
    if (container && !container.hasChildNodes()) {
      window.turnstileWidgetId = window.turnstile.render(container, {
        sitekey: container.getAttribute('data-sitekey'),
        action: 'contact',
      });
    }
  };
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad" async defer></script>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const success = document.getElementById('form-success');
    const error = document.getElementById('form-error');
    success?.classList.add('hidden');
    error?.classList.add('hidden');
    try {
      const formData = new FormData(form);
      const response = await fetch('/api/contact', {
        method: 'POST',
        body: formData,
      });
      if (response.ok) {
        success?.classList.remove('hidden');
        form.reset();
      } else {
        error?.classList.remove('hidden');
      }
    } catch {
      error?.classList.remove('hidden');
    } finally {
      const widgetId = (window as any).turnstileWidgetId;
      if (widgetId !== undefined) {
        (window as any).turnstile?.reset(widgetId);
      }
    }
  });
</script>
