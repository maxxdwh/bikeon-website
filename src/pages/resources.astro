---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import HeroSection from '../components/HeroSection.astro';
import { Icon } from 'astro-icon/components';
import { videos, playlistUrl } from '../data/videos';

const videosWithThumbs = videos.map((v) => {
  const id = v.url.match(/v=([\w-]+)/)?.[1] ?? '';
  return { ...v, thumb: `https://img.youtube.com/vi/${id}/hqdefault.jpg` };
});

const educationVideos = videosWithThumbs.filter((v) => v.category === 'Cycle education');
const gameVideos = videosWithThumbs.filter((v) => v.category === 'Bike Games');
---

<Layout title="Resources — Bike On NZ" description="Games, curriculum resources, and videos to use alongside a Bikes in Schools project, for teachers and classroom use.">
  <HeroSection
    title="Resources"
    description="Games, curriculum resources, and videos to use alongside a Bikes in Schools project, for teachers and classroom use."
    centered
  />

  <section class="w-full py-12">
    <div class="flex w-full gap-8 px-6 lg:px-12 lg:items-start">
      <div class="hidden flex-1 lg:block"></div>
      <div class="prose w-full max-w-[72ch] shrink-0 prose-p:text-[17px] prose-p:leading-[1.7] prose-headings:font-bold prose-headings:tracking-tight prose-headings:font-[var(--font-heading)] prose-headings:text-wrap-balance prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-4 prose-h2:first:mt-0 prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-3 prose-h4:text-xl prose-h4:mt-8 prose-h4:mb-3 prose-p:mt-5 prose-p:mb-5 prose-p:text-wrap-pretty prose-ul:mt-5 prose-ul:mb-5 prose-ol:mt-5 prose-ol:mb-5 prose-li:mt-2 prose-a:underline prose-strong:font-normal">

        <div class="not-prose mb-8 lg:hidden">
          <p class="mb-2 text-sm font-semibold text-muted-foreground">On this page</p>
          <div id="toc-pills" class="flex flex-wrap gap-2"></div>
        </div>

        <h2>Bike games for schools</h2>
        <p>
          NZTA's Bike games for schools covers key skills like balance, braking, and riding
          one-handed. Each card explains the equipment, setup, and instructions, with variations for
          different ages and abilities. Most work for balance bikes and trikes too.
        </p>
        <div class="not-prose mt-8">
          <img src="/images/bike-games.jpg" alt="Bike games for schools" class="w-full rounded-xl object-cover" loading="lazy" />
        </div>
        <p class="mt-4">
          <a href="https://www.bikeready.govt.nz/assets/BikeReady/Public-Resources/bikeready-bike-games-for-schools.pdf" target="_blank" rel="noopener noreferrer">Bike games for schools (PDF, 2 MB) <Icon name="tabler:arrow-up-right" class="ml-1 inline h-4 w-4 align-baseline" /></a>
        </p>

        <h2>For the classroom</h2>
        <p>
          These resources are written for New Zealand teachers and aligned with the New Zealand
          Curriculum. They cover practical riding skills, classroom-based learning, and safe travel
          programmes.
        </p>
        <ul>
          <li>
            <a href="https://www.bikeready.govt.nz/schools/curriculum-resources/" target="_blank" rel="noopener noreferrer">BikeReady curriculum resources</a>
            <br />
            Written by education specialist Pam Hook, aligned with New Zealand Curriculum achievement
            objectives, covering both practical and classroom-based learning.
          </li>
          <li>
            <a href="https://schooltravel.gw.govt.nz/resources-and-activities/classroom-ideas/active-travel-action/" target="_blank" rel="noopener noreferrer">Active Travel Action resource</a>
            <br />
            Developed by Greater Wellington Regional Council and Enviroschools, guides schools through
            sustainable active transport practices through student inquiry.
          </li>
          <li>
            <strong>Bikes in Schools: Schools Guide</strong>
            <br />
            Produced by Greater Wellington Regional Council, a handy guide for schools planning a
            Bikes in Schools project. Covers implementation, maintenance, and curriculum links.
          </li>
          <li>
            <a href="https://at.govt.nz/cycling-walking/travelwise-school-programme/travelwise-resources/" target="_blank" rel="noopener noreferrer">Travelwise resources</a>
            <br />
            Auckland Transport's resources covering safe travel behaviour for teachers and students.
          </li>
        </ul>

        <h2>Cycle education videos</h2>
        <p>
          These short, practical videos from NZTA cover helmet fitting, bike checks, and braking
          skills.
        </p>
        <p>
          <a href={playlistUrl}> See the full playlist on YouTube </a>.
        </p>
        <div class="not-prose mt-8 grid gap-4 sm:grid-cols-2">
          {educationVideos.map((video) => (
            <a
              href={video.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group overflow-hidden rounded-xl border border-border bg-card transition-all hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              <div class="relative aspect-video overflow-hidden">
                <img
                  src={video.thumb}
                  alt={video.title}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute inset-0 flex items-center justify-center bg-black/20 transition-opacity group-hover:bg-black/30">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/90 text-primary">
                    <span class="text-xl">▶</span>
                  </span>
                </span>
              </div>
              <div class="p-4">
                <p class="font-semibold">{video.title}</p>
                <p class="text-base text-muted-foreground opacity-50">youtube.com</p>
              </div>
            </a>
          ))}
        </div>

        <h2>Bike games</h2>
        <p>
          These bike games from NZTA are a fun way for students to practise key bike control skills
          like balance, braking, and riding with one hand. Each card explains the equipment, setup,
          and instructions, with variations for different ages and abilities. Most work for balance
          bikes and trikes too.
        </p>
        <div class="not-prose mt-8 grid gap-4 sm:grid-cols-2">
          {gameVideos.map((video) => (
            <a
              href={video.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group overflow-hidden rounded-xl border border-border bg-card transition-all hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              <div class="relative aspect-video overflow-hidden">
                <img
                  src={video.thumb}
                  alt={video.title}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute inset-0 flex items-center justify-center bg-black/20 transition-opacity group-hover:bg-black/30">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/90 text-primary">
                    <span class="text-xl">▶</span>
                  </span>
                </span>
              </div>
              <div class="p-4">
                <p class="font-semibold">{video.title}</p>
                <p class="text-base text-muted-foreground opacity-50">youtube.com</p>
              </div>
            </a>
          ))}
        </div>
        <p class="mt-8">
          Looking for training to go alongside these resources? See our <a href="/guide/cycle-skills-training">Cycle skills training</a> page.
        </p>

      </div>

      <aside class="hidden flex-1 lg:flex">
        <div class="sticky top-28 w-48">
          <p class="mb-2 text-base font-semibold">On this page</p>
          <ul id="toc-list" class="space-y-0 text-sm"></ul>
        </div>
      </aside>
    </div>
  </section>

  <CTASection />
</Layout>

<script>
  const article = document.querySelector('.prose');
  const tocList = document.getElementById('toc-list');
  if (article && tocList) {
    const headings = article.querySelectorAll('h2');
    const tocPills = document.getElementById('toc-pills');
    headings.forEach((h, i) => {
      if (!h.id) h.id = 'heading-' + i;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent;
      a.className = 'toc-link -ml-3 block rounded-lg px-3 py-1.5 text-muted-foreground transition-colors hover:bg-primary/10 hover:text-foreground';
      li.appendChild(a);
      tocList.appendChild(li);
      if (tocPills) {
        const pill = document.createElement('a');
        pill.href = '#' + h.id;
        pill.textContent = h.textContent;
        pill.className = 'toc-pill rounded-full border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted';
        tocPills.appendChild(pill);
      }
    });

    const tocLinks = tocList.querySelectorAll('.toc-link');
    const tocPillsAll = tocPills ? tocPills.querySelectorAll('.toc-pill') : [];
    let ticking = false;
    function updateActive() {
      let activeIdx = -1;
      headings.forEach((h, i) => {
        const rect = h.getBoundingClientRect();
        if (rect.top <= 120) activeIdx = i;
      });
      tocLinks.forEach((link, i) => {
        if (i === activeIdx) {
          link.classList.add('text-foreground', 'font-medium');
          link.classList.remove('text-muted-foreground');
        } else {
          link.classList.remove('text-foreground', 'font-medium');
          link.classList.add('text-muted-foreground');
        }
      });
      tocPillsAll.forEach((pill, i) => {
        if (i === activeIdx) {
          pill.classList.add('bg-primary/10', 'text-foreground', 'font-medium');
          pill.classList.remove('text-muted-foreground');
        } else {
          pill.classList.remove('bg-primary/10', 'text-foreground', 'font-medium');
          pill.classList.add('text-muted-foreground');
        }
      });
      ticking = false;
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateActive);
      }
    });
    updateActive();
  }
</script>
