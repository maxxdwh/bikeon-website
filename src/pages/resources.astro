---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import bikeGames from '../assets/images/bike-games.jpg';
import { videos, playlistUrl } from '../data/videos';

const videosWithThumbs = videos.map((v) => {
  const id = v.url.match(/v=([\w-]+)/)?.[1] ?? '';
  return { ...v, thumb: `https://img.youtube.com/vi/${id}/hqdefault.jpg` };
});

const educationVideos = videosWithThumbs.filter((v) => v.category === 'Cycle education');
const gameVideos = videosWithThumbs.filter((v) => v.category === 'Bike Games');
---

<Layout title="Resources — Bike On NZ" description="Games, curriculum resources, and videos to use alongside a Bikes in Schools project, for teachers and classroom use.">
  <section class="container-page page-top pb-[var(--section)]">
    <div class="flex w-full gap-12 lg:items-start lg:justify-between">
      <div class="w-full min-w-0 max-w-[var(--measure)]">
        <header class="flex flex-col gap-4">
          <h1 class="h-page">Resources</h1>
          <p class="lead">
            Games, curriculum resources, and videos to use alongside a Bikes in Schools project, for teachers and classroom use.
          </p>
        </header>

        <div class="no-print mt-8 rounded-lg bg-tint-2 px-6 py-5 lg:hidden">
          <p class="mb-3 text-lg font-bold">On this page</p>
          <div id="toc-pills" class="flex flex-col gap-2"></div>
        </div>

      <div class="prose mt-10">

        <h2 id="bike-games-for-schools">Bike games for schools</h2>
        <p>
          NZTA's Bike games for schools covers key skills like balance, braking, and riding
          one-handed. Each card explains the equipment, setup, and instructions, with variations for
          different ages and abilities. Most work for balance bikes and trikes too.
        </p>
        <div class="not-prose my-6">
          <Image src={bikeGames} alt="Bike games for schools" width={760} class="w-full rounded-xl object-cover" />
        </div>
        <p>
          <a href="https://www.bikeready.govt.nz/assets/BikeReady/Public-Resources/bikeready-bike-games-for-schools.pdf" target="_blank" rel="noopener noreferrer">Bike games for schools (PDF, 2 MB) <Icon name="tabler:arrow-up-right" class="ml-1 inline h-4 w-4 align-baseline" /></a>
        </p>

        <h2>For the classroom</h2>
        <p>
          These resources are written for New Zealand teachers and aligned with the New Zealand
          Curriculum. They cover practical riding skills, classroom-based learning, and safe travel
          programmes.
        </p>
        <ul>
          <li>
            <a href="https://www.bikeready.govt.nz/schools/curriculum-resources/" target="_blank" rel="noopener noreferrer">BikeReady curriculum resources</a>
            <br />
            Written by education specialist Pam Hook, aligned with New Zealand Curriculum achievement
            objectives, covering both practical and classroom-based learning.
          </li>
          <li>
            <a href="https://kurakete.gw.govt.nz/assets/Uploads/Making-it-count/ATA-full-resource.pdf" target="_blank" rel="noopener noreferrer">Active Travel Action resource (PDF)</a>
            <br />
            Developed by Greater Wellington Regional Council and Enviroschools, guides schools through
            sustainable active transport practices through student inquiry.
          </li>
          <li>
            <strong>Bikes in Schools: Schools Guide</strong>
            <br />
            Produced by Greater Wellington Regional Council, a handy guide for schools planning a
            Bikes in Schools project. Covers implementation, maintenance, and curriculum links.
          </li>
          <li>
            <a href="https://at.govt.nz/cycling-walking/travelwise-school-programme/travelwise-resources/" target="_blank" rel="noopener noreferrer">Travelwise resources</a>
            <br />
            Auckland Transport's resources covering safe travel behaviour for teachers and students.
          </li>
        </ul>

        <h2>Cycle education videos</h2>
        <p>
          These short, practical videos from NZTA cover helmet fitting, bike checks, and braking
          skills.
        </p>
        <p>
          <a href={playlistUrl} target="_blank" rel="noopener noreferrer"> See the full playlist on YouTube </a>.
        </p>
        <div class="not-prose mt-6 grid gap-4 sm:grid-cols-2">
          {educationVideos.map((video) => (
            <a
              href={video.url}
              target="_blank"
              rel="noopener noreferrer"
              class="panel group gap-0 overflow-hidden p-0"
            >
              <div class="relative aspect-video overflow-hidden">
                <Image
                  src={video.thumb}
                  alt={video.title}
                  width={372}
                  height={209}
                  fit="cover"
                  class="h-full w-full object-cover"
                />
                <span class="absolute inset-0 flex items-center justify-center">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white transition-colors group-hover:bg-ink">
                    <Icon name="tabler:player-play-filled" class="h-5 w-5" />
                  </span>
                </span>
              </div>
              <div class="px-5 py-4">
                <p class="font-bold leading-snug">{video.title}</p>
                <p class="meta mt-1">Video · {video.duration} · NZTA on YouTube</p>
              </div>
            </a>
          ))}
        </div>

        <h2>Bike games</h2>
        <p>
          These bike games from NZTA are a fun way for students to practise key bike control skills
          like balance, braking, and riding with one hand. Each video shows one game being played.
          The equipment, setup, and instructions for every game are on the cards in
          <a href="#bike-games-for-schools">Bike games for schools</a>.
        </p>
        <div class="not-prose mt-6 grid gap-4 sm:grid-cols-2">
          {gameVideos.map((video) => (
            <a
              href={video.url}
              target="_blank"
              rel="noopener noreferrer"
              class="panel group gap-0 overflow-hidden p-0"
            >
              <div class="relative aspect-video overflow-hidden">
                <Image
                  src={video.thumb}
                  alt={video.title}
                  width={372}
                  height={209}
                  fit="cover"
                  class="h-full w-full object-cover"
                />
                <span class="absolute inset-0 flex items-center justify-center">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white transition-colors group-hover:bg-ink">
                    <Icon name="tabler:player-play-filled" class="h-5 w-5" />
                  </span>
                </span>
              </div>
              <div class="px-5 py-4">
                <p class="font-bold leading-snug">{video.title}</p>
                <p class="meta mt-1">Video · {video.duration} · NZTA on YouTube</p>
              </div>
            </a>
          ))}
        </div>
        <p class="mt-8">
          Looking for training to go alongside these resources? See our <a href="/guide/cycle-skills-training" target="_blank" rel="noopener">Cycle skills training</a> page.
        </p>

      </div>
      </div>

      <aside class="no-print hidden shrink-0 self-stretch lg:block" style="width: 260px;">
        <div class="sticky top-24 rounded-lg bg-tint-2 px-6 py-5">
          <p class="mb-3 text-lg font-bold">On this page</p>
          <ul id="toc-list" class="flex flex-col gap-2"></ul>
        </div>
      </aside>
    </div>
  </section>

  <CTASection />
</Layout>

<script>
  const article = document.querySelector('.prose');
  const tocList = document.getElementById('toc-list');
  if (article && tocList) {
    const headings = article.querySelectorAll('h2');
    const tocPills = document.getElementById('toc-pills');
    headings.forEach((h, i) => {
      if (!h.id) h.id = 'heading-' + i;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent;
      a.className = 'toc-link block font-semibold leading-snug no-underline hover:underline';
      li.appendChild(a);
      tocList.appendChild(li);
      if (tocPills) {
        const pill = document.createElement('a');
        pill.href = '#' + h.id;
        pill.textContent = h.textContent;
        pill.className = 'toc-pill block font-semibold leading-snug no-underline hover:underline';
        tocPills.appendChild(pill);
      }
    });

    const tocLinks = tocList.querySelectorAll('.toc-link');
    const tocPillsAll = tocPills ? tocPills.querySelectorAll('.toc-pill') : [];
    let ticking = false;
    function updateActive() {
      let activeIdx = -1;
      headings.forEach((h, i) => {
        const rect = h.getBoundingClientRect();
        if (rect.top <= 120) activeIdx = i;
      });
      [...tocLinks, ...tocPillsAll].forEach((link, i) => {
        link.classList.toggle('text-ink', i % headings.length === activeIdx);
      });
      ticking = false;
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateActive);
      }
    });
    updateActive();
  }
</script>
