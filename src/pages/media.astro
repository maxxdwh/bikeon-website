---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import { Icon } from 'astro-icon/components';
import media from '../data/media.json';

function getHostname(url: string) {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return null;
  }
}

const pinnedSource = 'Beehive (NZ Government)';

const sourceCounts = Object.entries(
  media.reduce<Record<string, number>>((acc, m) => {
    acc[m.source] = (acc[m.source] ?? 0) + 1;
    return acc;
  }, {})
).sort((a, b) => b[1] - a[1])
  .filter(([source, count]) => count >= 5 || source === pinnedSource)
  .sort((a, b) => Number(b[0] === pinnedSource) - Number(a[0] === pinnedSource));

const sourceHostnames: Record<string, string> = {};
for (const m of media) {
  if (!sourceHostnames[m.source]) {
    const h = getHostname(m.url);
    if (h) sourceHostnames[m.source] = h;
  }
}

const mediaWithLogos = media.map((m) => ({
  ...m,
  hostname: getHostname(m.url),
}));
---

<Layout title="Media — Bike On NZ" description="Year by year press coverage since the very first Bikes in Schools opening back in 2010.">
  <HeroSection
    title="Media"
    description="Year by year press coverage since the very first Bikes in Schools opening back in 2010."
  />

  <section class="container-page page-end pt-4">
    <div class="flex flex-col gap-x-12 gap-y-6 lg:flex-row lg:items-start">
      <div class="flex flex-col lg:sticky lg:top-24 lg:w-72 lg:shrink-0">
        <div class="space-y-3">
          <div class="relative">
            <Icon name="tabler:search" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
            <label for="media-search" class="sr-only">Search stories</label>
            <input
              type="search"
              id="media-search"
              placeholder="Search stories..."
              class="field pl-10"
            />
          </div>

          <button id="mobile-filter-toggle" class="btn btn-secondary w-full lg:hidden">
            <Icon name="tabler:adjustments" class="h-4 w-4" /> Filter
          </button>

          <div id="publisher-list" class="space-y-1 lg:block hidden">
            <button data-source="all" class="publisher-chip flex w-full cursor-pointer items-center justify-between gap-2 rounded-sm px-3 py-2 text-left text-base font-semibold transition-colors hover:bg-tint-2 bg-tint text-primary">Show all</button>
            {sourceCounts.map(([source, count]) => (
              <button data-source={source} class="publisher-chip flex w-full cursor-pointer items-center gap-2 rounded-sm px-3 py-2 text-left text-base font-semibold transition-colors hover:bg-tint-2">
                {sourceHostnames[source] ? (
                  <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-white">
                    <img
                      src={`https://www.google.com/s2/favicons?domain=${sourceHostnames[source]}&sz=32`}
                      alt=""
                      width="12"
                      height="12"
                      class="h-3 w-3 object-contain"
                      loading="lazy"
                    />
                  </span>
                ) : null}
                <span class="truncate">{source}</span>
                <span class="meta ml-auto shrink-0 font-normal">{count}</span>
              </button>
            ))}
          </div>

          <div class="flex items-center justify-between px-3 text-base text-muted-foreground">
            <span id="story-count">{media.length} stories</span>
            <button id="reset-search" class="hidden cursor-pointer font-semibold text-link underline hover:text-ink">Clear</button>
          </div>
        </div>
      </div>

      <div class="flex-1">
        <div id="media-cards" class="divide-y divide-line-soft border-y-2 border-t-ink border-b-line-soft">
          {mediaWithLogos.map((story) => (
            story.archived ? (
              <div
                data-search={`${story.title} ${story.source} ${story.date} ${story.year}`.toLowerCase()}
                data-year={story.year}
                data-source={story.source}
                class="media-card group flex items-start gap-3 py-3.5"
              >
                {story.hostname ? (
                  <img
                    src={`https://www.google.com/s2/favicons?domain=${story.hostname}&sz=96`}
                    alt=""
                    width="20"
                    height="20"
                    class="mt-1 h-5 w-5 shrink-0 object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-tint text-sm font-bold text-primary">
                    {story.source.charAt(0)}
                  </span>
                )}
                <div class="min-w-0 flex-1">
                  <p class="font-semibold leading-snug text-ink">{story.title}</p>
                  <p class="meta mt-0.5">{story.source} · {story.date}</p>
                </div>
                <span class="meta mt-0.5 shrink-0">Archived</span>
              </div>
            ) : (
              <a
                href={story.url}
                target="_blank"
                rel="noopener noreferrer"
                data-search={`${story.title} ${story.source} ${story.date} ${story.year}`.toLowerCase()}
                data-year={story.year}
                data-source={story.source}
                class="media-card group flex items-start gap-3 py-3.5 no-underline"
              >
                {story.hostname ? (
                  <img
                    src={`https://www.google.com/s2/favicons?domain=${story.hostname}&sz=96`}
                    alt=""
                    width="20"
                    height="20"
                    class="mt-1 h-5 w-5 shrink-0 object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-tint text-sm font-bold text-primary">
                    {story.source.charAt(0)}
                  </span>
                )}
                <div class="min-w-0 flex-1">
                  <p class="font-semibold leading-snug group-hover:underline">{story.title}</p>
                  <p class="meta mt-0.5">{story.source} · {story.date}</p>
                </div>
                <Icon name="tabler:arrow-up-right" class="mt-1 h-4 w-4 shrink-0 text-muted-foreground group-hover:text-ink" />
              </a>
            )
          ))}
        </div>
        <div id="no-results" class="hidden flex-col items-center justify-center gap-3 py-16 text-center">
          <div class="space-y-1">
            <p class="h3">No stories found</p>
            <p class="copy">Try a different search or clear your filters.</p>
          </div>
          <button id="no-results-clear" class="btn btn-secondary mt-4">Clear filters</button>
        </div>
      </div>
    </div>
  </section>

  <div id="drawer-overlay" class="fixed inset-0 z-[60] bg-ink/50 lg:hidden hidden"></div>
  <aside id="publisher-drawer" class="fixed inset-x-0 bottom-0 z-[70] max-h-[75vh] translate-y-full rounded-t-2xl bg-white p-5 transition-transform duration-200 lg:hidden">
    <div class="flex items-center justify-between">
      <h2 class="h3">Publishers</h2>
      <button id="drawer-close" class="cursor-pointer rounded-full p-2 hover:bg-tint-2" aria-label="Close">
        <Icon name="tabler:x" class="h-5 w-5" />
      </button>
    </div>
    <div id="drawer-publishers" class="mt-4 max-h-[60vh] space-y-1 overflow-y-auto"></div>
  </aside>
</Layout>

<script is:inline>
  const searchInput = document.getElementById('media-search');
  const countLabel = document.getElementById('story-count');
  const resetBtn = document.getElementById('reset-search');
  const noResults = document.getElementById('no-results');
  const cardsContainer = document.getElementById('media-cards');
  const cards = document.querySelectorAll('.media-card');
  const chips = document.querySelectorAll('.publisher-chip');
  let activeSource = 'all';

  function filter() {
    const query = searchInput.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const searchText = card.getAttribute('data-search') ?? '';
      const cardSource = card.getAttribute('data-source') ?? '';
      const show = (query === '' || searchText.includes(query)) && (activeSource === 'all' || cardSource === activeSource);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    countLabel.textContent = visible + (visible === 1 ? ' story' : ' stories');
    noResults.classList.toggle('hidden', visible > 0);
    cardsContainer.classList.toggle('hidden', visible === 0);
    const hasFilters = query !== '' || activeSource !== 'all';
    resetBtn.classList.toggle('hidden', !hasFilters);
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeSource = chip.getAttribute('data-source');
      chips.forEach((c) => c.classList.remove('bg-tint', 'text-primary'));
      chip.classList.add('bg-tint', 'text-primary');
      filter();
    });
  });

  searchInput.addEventListener('input', filter);
  function clearFilters() {
    searchInput.value = '';
    activeSource = 'all';
    chips.forEach((c) => c.classList.remove('bg-tint', 'text-primary'));
    chips[0].classList.add('bg-tint', 'text-primary');
    filter();
  }
  resetBtn.addEventListener('click', clearFilters);
  document.getElementById('no-results-clear').addEventListener('click', clearFilters);

  const mobileToggle = document.getElementById('mobile-filter-toggle');
  const drawer = document.getElementById('publisher-drawer');
  const overlay = document.getElementById('drawer-overlay');
  const drawerClose = document.getElementById('drawer-close');
  const drawerPublishers = document.getElementById('drawer-publishers');
  const publisherList = document.getElementById('publisher-list');

  function openDrawer() {
    drawerPublishers.innerHTML = publisherList.innerHTML;
    drawer.classList.remove('translate-y-full');
    overlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    drawerPublishers.querySelectorAll('.publisher-chip').forEach((chip) => {
      if (chip.getAttribute('data-source') === activeSource) {
        chip.classList.add('bg-tint', 'text-primary');
      }
      chip.addEventListener('click', () => {
        activeSource = chip.getAttribute('data-source');
        publisherList.querySelectorAll('.publisher-chip').forEach((c) => c.classList.remove('bg-tint', 'text-primary'));
        publisherList.querySelector(`[data-source="${activeSource}"]`).classList.add('bg-tint', 'text-primary');
        closeDrawer();
        filter();
      });
    });
  }

  function closeDrawer() {
    drawer.classList.add('translate-y-full');
    overlay.classList.add('hidden');
    document.body.style.overflow = '';
  }

  mobileToggle.addEventListener('click', openDrawer);
  drawerClose.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
</script>
