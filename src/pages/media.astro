---
import Layout from '../layouts/Layout.astro';
import media from '../data/media.json';

const years = [...new Set(media.map((m) => m.year))].sort((a, b) => b - a);
---

<Layout title="Media — Bike On NZ" description="Year by year press coverage since the very first Bikes in Schools opening back in 2010.">
  <section class="border-b border-border bg-gradient-to-b from-primary/5 to-background">
    <div class="container-page pt-28 pb-20 md:pt-36 md:pb-28">
      <div class="max-w-[68ch]">
        <h1 class="text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl">Media</h1>
        <p class="mt-6 text-[17px] text-muted-foreground md:text-xl">
          Year by year press coverage since the very first Bikes in Schools opening back in 2010.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page py-12">
    <div class="mb-8 flex flex-wrap items-center gap-3">
      <label for="year-filter" class="text-base font-medium">Filter by year:</label>
      <select
        id="year-filter"
        class="rounded-lg border border-input bg-background px-3 py-2 text-base outline-none focus:border-ring focus:ring-1 focus:ring-ring"
      >
        <option value="all">All years</option>
        {years.map((year) => (
          <option value={year}>{year}</option>
        ))}
      </select>
      <span id="story-count" class="text-base text-muted-foreground">{media.length} stories</span>
    </div>

    <div id="media-list" class="grid gap-3">
      {media.map((story) => (
        <a
          href={story.url}
          target="_blank"
          rel="noopener noreferrer"
          data-year={story.year}
          class="media-item group flex items-start justify-between gap-4 rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/50 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          <div class="min-w-0">
            <p class="font-medium group-hover:text-link">{story.title}</p>
            <p class="mt-1 text-base text-muted-foreground">{story.source}</p>
          </div>
          <div class="shrink-0 text-right">
            <p class="text-base text-muted-foreground">{story.date}</p>
            <p class="text-base text-muted-foreground">{story.year}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<script>
  const filter = document.getElementById('year-filter') as HTMLSelectElement | null;
  const count = document.getElementById('story-count');
  const items = document.querySelectorAll<HTMLElement>('.media-item');

  filter?.addEventListener('change', (e) => {
    const year = (e.target as HTMLSelectElement).value;
    let visible = 0;

    items.forEach((item) => {
      const itemYear = item.getAttribute('data-year');
      const show = year === 'all' || itemYear === year;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (count) count.textContent = `${visible} stories`;
  });
</script>
