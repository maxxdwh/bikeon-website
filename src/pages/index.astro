---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import CTASection from '../components/CTASection.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import heroHelmet from '../assets/images/guide/helmets.webp';
import royalOak from '../assets/images/about/royal-oak-opening.jpg';
import ptEngland from '../assets/images/about/pt-england-opening.jpg';
import bledisloe from '../assets/images/bledisloe-opening.jpg';
import friendsOnTrack from '../assets/images/about/friends-on-the-track.jpg';
import ribbonCutting from '../assets/images/about/ribbon-cutting.jpg';
import holyCross from '../assets/images/about/holy-cross-kids.jpg';
import Testimonials from '../components/Testimonials.astro';
import ImpactGrid from '../components/ImpactGrid.astro';

const guides = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);

const impact = [
  { stat: '200,000+', label: 'students with regular bike access', image: friendsOnTrack, alt: 'Kids riding on a bike track' },
  { stat: '400+', label: 'schools with a project', image: ribbonCutting, alt: 'Bikes in Schools opening event' },
  { stat: '2010', label: 'the year we started', image: holyCross, alt: 'Children with bikes at school' },
];

const guideIcons: Record<string, string> = {
  introduction: 'tabler:flag',
  bikes: 'tabler:bike',
  helmets: 'tabler:helmet',
  'bike-storage': 'tabler:building-warehouse',
  'bike-tracks': 'tabler:route',
  'cycle-skills-training': 'tabler:school',
  'costs-and-funding': 'tabler:coin',
  maintenance: 'tabler:tool',
};
---

<Layout>
  <section class="container-page flex flex-wrap items-center gap-12 py-[clamp(2.5rem,7vw,4rem)]">
    <div class="flex min-w-0 flex-[1_1_26rem] flex-col gap-6">
      <h1 class="h-hero">Every Kiwi kid, riding a bike at school.</h1>
      <p class="lead">
        We help schools across New Zealand set up a complete Bikes in Schools package:{' '}
        <a href="/guide/bikes" target="_blank" rel="noopener">bikes</a>,{' '}
        <a href="/guide/helmets" target="_blank" rel="noopener">helmets</a>,{' '}
        <a href="/guide/bike-tracks" target="_blank" rel="noopener">bike tracks</a>,{' '}
        <a href="/guide/bike-storage" target="_blank" rel="noopener">secure storage</a>, and{' '}
        <a href="/guide/cycle-skills-training" target="_blank" rel="noopener">cycle skills training</a>,
        all on-site.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/guide/introduction" class="btn">Read the Guide</a>
        <a
          href="/downloads/bikes-in-schools-101.pdf"
          target="_blank"
          rel="noopener"
          class="btn btn-secondary"
        >
          1-pager PDF
        </a>
      </div>
    </div>
    <div class="grid min-w-0 flex-[1_1_24rem] grid-cols-5 grid-rows-2 gap-3 md:gap-4">
      <Image
        src={heroHelmet}
        alt="A girl having her helmet fitted before a ride"
        width={420}
        height={430}
        fit="cover"
        priority
        class="col-span-3 row-span-2 h-full w-full rounded-2xl object-cover"
      />
      <Image
        src={royalOak}
        alt="Children riding the track at Royal Oak School"
        width={280}
        height={210}
        fit="cover"
        loading="eager"
        class="col-span-2 aspect-[4/3] h-full w-full rounded-2xl object-cover"
      />
      <Image
        src={ptEngland}
        alt="Riders at the Pt England School opening"
        width={280}
        height={210}
        fit="cover"
        loading="eager"
        class="col-span-2 aspect-[4/3] h-full w-full rounded-2xl object-cover"
      />
    </div>
  </section>

  <section class="container-page pb-[var(--section)]">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/guide/introduction" class="panel">
        <Icon name="tabler:book" class="h-6 w-6 text-primary" />
        <div>
          <h3 class="h3">Read the guide</h3>
          <p class="copy mt-1">Plan and run a project.</p>
        </div>
      </a>
      <a href="/map" class="panel">
        <Icon name="tabler:map" class="h-6 w-6 text-primary" />
        <div>
          <h3 class="h3">Explore the map</h3>
          <p class="copy mt-1">400+ schools across Aotearoa.</p>
        </div>
      </a>
      <a href="/resources" class="panel">
        <Icon name="tabler:school-bell" class="h-6 w-6 text-primary" />
        <div>
          <h3 class="h3">Teaching resources</h3>
          <p class="copy mt-1">Games, curriculum, and videos.</p>
        </div>
      </a>
      <a href="/contact" class="panel">
        <Icon name="tabler:mail" class="h-6 w-6 text-primary" />
        <div>
          <h3 class="h3">Contact us</h3>
          <p class="copy mt-1">Free advice for any school.</p>
        </div>
      </a>
    </div>
  </section>

  <section class="bg-tint">
    <div class="container-page section">
      <h2 class="h2">What is Bikes in Schools?</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3 md:gap-12">
        <div>
          <h3 class="h3">A complete package</h3>
          <p class="copy mt-2">
            The school owns a fleet of bikes, helmets, and tracks, all on-site. Every child can ride
            during the school day, not just those with a bike at home.
          </p>
        </div>
        <div>
          <h3 class="h3">Built into the school day</h3>
          <p class="copy mt-2">
            Teachers incorporate riding into the curriculum. No special trips or transport. Kids walk
            out the door and ride. Low input for staff, high output for students.
          </p>
        </div>
        <div>
          <h3 class="h3">Everything included</h3>
          <p class="copy mt-2">
            Bikes, helmets, tracks, secure storage, and cycle skills training. Around $200 per child
            one-off, with funding support available from councils and funders.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page section flex flex-wrap items-center gap-12">
    <div class="flex min-w-0 flex-[1_1_24rem] flex-col gap-4">
      <h2 class="h2">Why Bikes in Schools?</h2>
      <p class="copy">
        In 1990, Kiwi kids biked 28 minutes a week. Today it's under 5 minutes, and many
        don't ride at all.
      </p>
      <p class="copy">
        Bikes in Schools puts a complete biking package on school grounds so every child can
        ride, not just those with a bike at home. Principals report more confident, active
        students.
      </p>
    </div>
    <div class="min-w-0 flex-[1_1_24rem]">
      <Image
        src={bledisloe}
        alt="Bikes in Schools opening event"
        width={580}
        class="w-full rounded-2xl object-cover"
      />
    </div>
  </section>

  <section class="bg-tint">
    <div class="container-page section">
      <div class="flex flex-col items-start gap-4">
        <h2 class="h2">Impact, nationwide</h2>
        <p class="lead">
          Every school day, kids who might never ride otherwise are out on bikes, helmets, and tracks
          built right into their school grounds.
        </p>
        <a href="/map" class="btn mt-2">Explore the map</a>
      </div>
      <ImpactGrid items={impact} />
    </div>
  </section>

  <section class="container-page section">
    <div class="flex flex-col gap-4">
      <h2 class="h2">Explore the guide</h2>
      <p class="lead">
        Everything you need to plan, build, and run a Bikes in Schools project. The school owns all the
        bikes and helmets, and the tracks are built on school grounds. See it in action on our{' '}
        <a href="https://www.youtube.com/@bikesinschoolsnz" target="_blank" rel="noopener noreferrer">YouTube channel</a>.
      </p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {guides.map((guide) => (
        <a href={`/guide/${guide.id}`} class="panel">
          <Icon name={guideIcons[guide.id] ?? 'tabler:circle'} class="h-6 w-6 text-primary" />
          <div>
            <h3 class="h3">{guide.data.title}</h3>
            <p class="copy mt-1">{guide.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <Testimonials divider />

  <CTASection />
</Layout>
