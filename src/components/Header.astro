---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-long.svg';
import { navItems } from '../data/nav';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
const isGroupActive = (item: (typeof navItems)[number]) =>
  item.children ? pathname.startsWith('/guide') : isActive(item.href!);
---

<header class="site-header">
  <div class="container-page bar">
    <a class="brand" href="/">
      <Image src={logo} alt="Bikes in Schools" width={178} height={28} layout="fixed" loading="eager" class="h-7 w-auto" />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path class="i-open" d="M3 6h14M3 10h14M3 14h14"></path>
        <path class="i-close" d="M5 5l10 10M15 5L5 15"></path>
      </svg>
      <span data-menu-label>Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {navItems.map((item) => (
          <li class:list={[item.children && 'has-sub']}>
            <a href={item.href} aria-current={isGroupActive(item) ? 'page' : undefined}>
              {item.label}
              {item.children && (
                <svg class="caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                  <path d="M2.5 4.5 6 8l3.5-3.5"></path>
                </svg>
              )}
            </a>
            {item.children && (
              <button
                type="button"
                class="sub-toggle"
                aria-expanded={isGroupActive(item) ? 'true' : 'false'}
                aria-controls="sub-guide"
                data-current={isGroupActive(item) ? '' : undefined}
                data-sub-toggle
              >
                {item.label}
                <svg width="16" height="16" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                  <path d="M2.5 4.5 6 8l3.5-3.5"></path>
                </svg>
              </button>
            )}
            {item.children && (
              <ul class="sub" id="sub-guide" data-open={isGroupActive(item) ? '' : undefined}>
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (toggle && nav && label) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      label.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }

  document.querySelectorAll<HTMLButtonElement>('[data-sub-toggle]').forEach((button) => {
    const sub = document.getElementById(button.getAttribute('aria-controls') ?? '');
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      sub?.toggleAttribute('data-open', open);
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    min-height: var(--header-h);
  }
  .site-nav {
    font-weight: 600;
    font-size: 1rem;
  }
  .site-nav ul {
    padding: 0;
    list-style: none;
  }
  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }
  .site-nav__list > li {
    position: relative;
  }
  .site-nav__list > li > a {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding-block: 0.75rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .site-nav__list > li > a:hover {
    border-bottom-color: var(--brand);
  }
  .site-nav__list > li > a[aria-current='page'] {
    border-bottom-color: var(--blue-700);
  }
  .caret {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sub a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .sub a:hover {
    background: var(--tint-2);
  }
  .sub a[aria-current='page'] {
    color: var(--blue-700);
  }

  .sub-toggle {
    display: none;
  }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    border: 2px solid var(--line-strong);
    background: #fff;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
  .menu-toggle svg {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    fill: none;
  }
  .menu-toggle .i-close,
  .menu-toggle[aria-expanded='true'] .i-open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .i-close {
    display: inline;
  }

  @media (min-width: 64rem) {
    .site-nav__list > li > a {
      height: var(--header-h);
      padding-block: 0;
    }
    .sub {
      position: absolute;
      left: -0.75rem;
      top: 100%;
      width: 15rem;
      padding: 0.5rem;
      border: 1px solid var(--line);
      border-radius: 1rem;
      background: #fff;
      box-shadow: 0 12px 24px -12px rgb(11 31 42 / 0.25);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.15s,
        visibility 0.15s;
    }
    .has-sub:hover .sub,
    .has-sub:focus-within .sub {
      visibility: visible;
      opacity: 1;
    }
  }

  @media (max-width: 63.99rem) {
    :global(.js) .menu-toggle {
      display: inline-flex;
    }
    .site-nav {
      width: 100%;
      height: calc(100dvh - var(--header-h) - 1px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-bottom: 2rem;
    }
    :global(.js) .site-nav:not([data-open]) {
      display: none;
    }
    .site-nav__list {
      flex-direction: column;
    }
    .site-nav__list > li > a {
      padding: 0.875rem 0.25rem;
      font-size: 1.125rem;
      border-bottom: 1px solid var(--line-soft);
    }
    .site-nav__list > li > a:hover {
      border-bottom-color: var(--line-soft);
    }
    .site-nav__list > li > a[aria-current='page'] {
      color: var(--blue-700);
      border-bottom-color: var(--line-soft);
    }
    .caret {
      display: none;
    }
    :global(.js) .site-nav__list > li.has-sub > a {
      display: none;
    }
    :global(.js) .sub-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 0.875rem 0.25rem;
      border: 0;
      border-bottom: 1px solid var(--line-soft);
      background: none;
      font-size: 1.125rem;
      font-weight: 600;
      text-align: left;
      color: var(--ink);
      cursor: pointer;
    }
    .sub-toggle[data-current] {
      color: var(--blue-700);
    }
    .sub-toggle svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform 0.15s;
    }
    .sub-toggle[aria-expanded='true'] svg {
      transform: rotate(180deg);
    }
    .sub {
      padding: 0.25rem 0 0.5rem 0.75rem;
      border-bottom: 1px solid var(--line-soft);
      font-weight: 500;
    }
    :global(.js) .sub:not([data-open]) {
      display: none;
    }
  }
</style>
