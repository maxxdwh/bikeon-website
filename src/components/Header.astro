---
import { navItems } from '../data/nav';
import { Icon } from 'astro-icon/components';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header class="fixed left-1/2 top-3 z-50 w-[calc(100%-1.5rem)] max-w-[80rem] -translate-x-1/2">
  <nav class="flex h-16 items-center justify-between rounded-2xl border border-black/5 bg-background/80 px-6 shadow-lg shadow-black/5 backdrop-blur-lg">
    <a href="/" class="flex items-center gap-2">
      <img src="/images/logo-long.png" alt="Bike On NZ" class="h-8 w-auto" />
    </a>

    <ul class="hidden items-center gap-0.5 lg:flex">
      {navItems.map((item) => (
        <li class="relative">
          {item.children ? (
            <div class="group relative focus-within:block">
              <a
                href={item.href}
                class={`flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-base font-medium transition-colors hover:bg-black/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${isActive(item.href!) ? "text-link" : "text-foreground"}`}
                aria-haspopup="true"
              >
                {item.label}
                <Icon name="tabler:chevron-down" class="h-3.5 w-3.5 opacity-50" />
              </a>
              <ul class="invisible absolute left-0 top-full mt-1 w-56 rounded-xl border border-black/5 bg-card p-1 opacity-0 shadow-lg transition-all group-hover:visible group-focus-within:visible group-hover:opacity-100 group-focus-within:opacity-100">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class={`block rounded-lg px-3 py-2 text-base transition-colors hover:bg-black/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${isActive(child.href) ? "text-link font-medium" : "text-foreground"}`}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={item.href}
              class={`block rounded-lg px-2.5 py-1.5 text-base font-medium transition-colors hover:bg-black/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${isActive(item.href!) ? "text-link" : "text-foreground"}`}
            >
              {item.label}
            </a>
          )}
        </li>
      ))}
    </ul>

    <button
      id="mobile-menu-toggle"
      class="inline-flex items-center justify-center rounded-lg p-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="tabler:menu-2" class="h-5 w-5" />
    </button>
  </nav>

  <div id="mobile-menu" class="hidden mt-2 rounded-2xl border border-black/5 bg-card/90 p-2 shadow-lg backdrop-blur-lg lg:hidden">
    <ul class="space-y-0.5">
      {navItems.map((item) => (
        <li>
          {item.children ? (
            <details class="group">
              <summary class={`flex cursor-pointer items-center justify-between rounded-lg px-3 py-2 text-base font-medium transition-colors hover:bg-black/5 ${isActive(item.href!) ? "text-link" : "text-foreground"}`}>
                {item.label}
                <Icon name="tabler:chevron-down" class="h-3.5 w-3.5 transition-transform group-open:rotate-180" />
              </summary>
              <ul class="ml-2 mt-0.5 space-y-0.5 border-l border-black/5 pl-2">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class={`block rounded-lg px-3 py-2 text-base transition-colors hover:bg-black/5 ${isActive(child.href) ? "text-link font-medium" : "text-muted-foreground"}`}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              href={item.href}
              class={`block rounded-lg px-3 py-2 text-base font-medium transition-colors hover:bg-black/5 ${isActive(item.href!) ? "text-link" : "text-foreground"}`}
            >
              {item.label}
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', menu?.classList.contains('hidden') ? 'false' : 'true');
  });
</script>
