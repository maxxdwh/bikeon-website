---
import { Image } from 'astro:assets';
import opening1 from '../assets/images/opening-event-1.jpg';
import opening2 from '../assets/images/opening-event-2.jpg';
import opening3 from '../assets/images/opening-event-3.jpg';
import bledisloe from '../assets/images/bledisloe-opening.jpg';

const photos = [opening1, opening2, opening3, bledisloe];
---

<section class="bg-tint">
  <div class="container-page section flex flex-wrap items-center gap-x-12 gap-y-8">
    <div class="flex min-w-0 flex-[1_1_26rem] flex-col gap-4">
      <h2 class="h2">Planning a Bikes in Schools project?</h2>
      <p class="lead">
        Our guide covers everything: bikes, helmets, tracks, storage, training, costs, and funding. It's
        free, and so is our advice.
      </p>
      <div class="mt-2 flex flex-wrap gap-3">
        <a href="/guide/introduction" class="btn">Read the guide</a>
      </div>
    </div>
    <div class="hidden min-w-0 flex-[1_1_22rem] grid-cols-2 gap-3 md:grid">
      {photos.map((photo) => (
        <Image src={photo} alt="" width={320} height={240} fit="cover" class="aspect-[4/3] w-full rounded-xl object-cover" />
      ))}
    </div>
  </div>
</section>
