---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { testimonials } from '../data/testimonials';

interface Props {
  divider?: boolean;
}

const { divider = false } = Astro.props;
---

<section id="what-people-say" class:list={['overflow-hidden pb-[var(--section)]', !divider && 'pt-[var(--section)]']}>
  <div class:list={['container-page mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between', divider && 'border-t border-border pt-[var(--section)]']}>
    <div class="flex flex-col gap-4">
      <h2 class="h2">What people say</h2>
      <p class="lead">
        Principals, politicians, and world champion riders on Bikes in Schools.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <button id="testimonial-prev" class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border-2 border-[var(--line-strong)] text-ink transition-colors hover:border-ink hover:bg-ink hover:text-white" aria-label="Previous testimonial">
        <Icon name="tabler:arrow-left" class="h-5 w-5" />
      </button>
      <button id="testimonial-next" class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border-2 border-[var(--line-strong)] text-ink transition-colors hover:border-ink hover:bg-ink hover:text-white" aria-label="Next testimonial">
        <Icon name="tabler:arrow-right" class="h-5 w-5" />
      </button>
    </div>
  </div>
  <div class="container-page">
    <div id="testimonial-viewport" class="overflow-hidden">
      <div id="testimonial-track" class="flex snap-x snap-mandatory overflow-x-auto gap-6 pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {testimonials.map((t) => (
          <figure class="flex w-[85%] shrink-0 snap-start flex-col gap-5 md:w-[45%] lg:w-[31%]">
            <div class="aspect-[16/9] overflow-hidden rounded-xl bg-tint">
              <Image
                src={t.image}
                alt={t.name}
                width={420}
                height={236}
                fit="cover"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="quote">
              <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
              <figcaption>
                <p class="font-bold">{t.name}</p>
                <p class="meta">{t.role}</p>
              </figcaption>
            </div>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('testimonial-track');
  const prevBtn = document.getElementById('testimonial-prev');
  const nextBtn = document.getElementById('testimonial-next');
  if (track && prevBtn && nextBtn) {
    const step = () => (track.children[0] as HTMLElement).offsetWidth + 24;
    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
  }
</script>
