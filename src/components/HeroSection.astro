---
interface Props {
  title: string;
  description?: string;
  narrow?: boolean;
}

const { title, description, narrow = false } = Astro.props;
---

<header class:list={[narrow ? 'measure' : 'container-page', 'page-top flex flex-col gap-4 pb-8']}>
  <h1 class="h-page">{title}</h1>
  {description && <p class="lead">{description}</p>}
</header>
