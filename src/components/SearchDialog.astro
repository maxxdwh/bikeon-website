---
import { Icon } from 'astro-icon/components';
---

<dialog id="search-dialog" class="search no-print" aria-labelledby="search-title">
  <div class="search__head">
    <h2 id="search-title" class="sr-only">Search the site</h2>
    <Icon name="tabler:search" class="search__icon h-5 w-5" />
    <input
      id="search-input"
      class="search__input"
      type="search"
      placeholder="Search the guide, resources and more"
      aria-label="Search"
      role="combobox"
      aria-expanded="false"
      aria-autocomplete="list"
      aria-controls="search-results"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
    />
    <button type="button" class="search__close" data-search-close aria-label="Close search">
      <Icon name="tabler:x" class="h-5 w-5" />
    </button>
  </div>
  <div id="search-types" class="search__types" role="group" aria-label="Filter results by type" hidden></div>
  <p id="search-status" class="search__status" role="status" aria-live="polite"></p>
  <ul id="search-results" class="search__results" role="listbox" aria-label="Search results"></ul>
</dialog>

<script>
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const status = document.getElementById('search-status');
  const list = document.getElementById('search-results');
  const typesEl = document.getElementById('search-types');
  const TYPES = ['Guide', 'Page', 'Map', 'News'];
  let activeType = 'All';

  type Sub = { url: string; title?: string; excerpt?: string };
  type Data = { url: string; excerpt: string; meta: { title?: string; kind?: string; place?: string }; sub_results?: Sub[] };
  type Pagefind = {
    filters: () => Promise<unknown>;
    debouncedSearch: (
      q: string,
      o?: object,
      ms?: number,
    ) => Promise<{ results: { data: () => Promise<Data> }[]; filters?: { type?: Record<string, number> }; totalFilters?: { type?: Record<string, number> } } | null>;
  };

  let pagefind: Pagefind | null = null;
  let loading: Promise<Pagefind | null> | null = null;
  let unavailable = false;

  const load = () => {
    loading ??= (async () => {
      try {
        const url = '/pagefind/pagefind.js';
        pagefind = await import(/* @vite-ignore */ url);
        await pagefind?.filters();
      } catch {
        unavailable = true;
      }
      return pagefind;
    })();
    return loading;
  };

  const setStatus = (text: string) => {
    if (status) status.textContent = text;
  };

  const track = (event: string, props: Record<string, unknown>) =>
    (window as unknown as { posthog?: { capture: (e: string, p: object) => void } }).posthog?.capture(event, props);
  let lastQuery = '';
  let reportTimer: ReturnType<typeof setTimeout> | undefined;

  let active = -1;
  const links = () => [...(list?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
  const setActive = (index: number) => {
    const all = links();
    active = all.length ? (index + all.length) % all.length : -1;
    all.forEach((link, i) => {
      link.classList.toggle('is-active', i === active);
      link.setAttribute('aria-selected', String(i === active));
    });
    if (active >= 0) {
      input?.setAttribute('aria-activedescendant', all[active].id);
      all[active].scrollIntoView({ block: 'nearest' });
    } else {
      input?.removeAttribute('aria-activedescendant');
    }
    input?.setAttribute('aria-expanded', String(all.length > 0));
  };

  const render = (items: Data[], query: string) => {
    if (!list) return;
    list.replaceChildren(
      ...items.map((item, i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'presentation');
        const a = document.createElement('a');
        a.id = `search-result-${i}`;
        a.setAttribute('role', 'option');
        a.href = (item.sub_results?.[0]?.url ?? item.url).replace(/(.)\/(#|$)/, '$1$2');
        const body = document.createElement('span');
        body.className = 'search__body';
        const tag = document.createElement('span');
        tag.className = 'search__tag';
        if (item.meta.kind === 'school' || item.meta.kind === 'news') {
          const news = item.meta.kind === 'news';
          a.href = item.url;
          if (news) {
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
          }
          const name = document.createElement('span');
          name.className = 'search__title';
          name.textContent = item.meta.title ?? '';
          const place = document.createElement('span');
          place.className = 'search__excerpt';
          place.textContent = item.meta.place ?? '';
          body.append(name, place);
          if (news) {
            const hint = document.createElement('span');
            hint.className = 'sr-only';
            hint.textContent = ' (opens in a new tab)';
            body.append(hint);
          }
          tag.textContent = news ? 'News' : 'Map';
        } else {
          const sub = item.sub_results?.[0];
          const page = (item.meta.title ?? item.url).replace(/\s+[|-]\s+Bike On NZ$/, '');
          const title = document.createElement('span');
          title.className = 'search__title';
          title.textContent = page;
          body.append(title);
          if (sub?.title && sub.title !== page) {
            const section = document.createElement('span');
            section.className = 'search__section';
            section.textContent = sub.title;
            body.append(section);
          }
          const excerpt = document.createElement('span');
          excerpt.className = 'search__excerpt';
          excerpt.innerHTML = sub?.excerpt ?? item.excerpt;
          body.append(excerpt);
          tag.textContent = new URL(a.href).pathname.startsWith('/guide/') ? 'Guide' : 'Page';
        }
        a.append(body, tag);
        li.append(a);
        return li;
      }),
    );
    setActive(0);
    lastQuery = query;
    clearTimeout(reportTimer);
    reportTimer = setTimeout(() => track('site_search', { query, result_count: items.length }), 1000);
    setStatus(
      items.length
        ? `${items.length} ${items.length === 1 ? 'result' : 'results'}`
        : `No results for “${query}”. Try a simpler word, like “helmet” or “funding”.`,
    );
  };

  let latest = 0;
  const run = async () => {
    const query = input?.value.trim() ?? '';
    const id = ++latest;
    if (!query) {
      list?.replaceChildren();
      typesEl?.replaceChildren();
      if (typesEl) typesEl.hidden = true;
      setActive(-1);
      setStatus('');
      return;
    }
    const pf = await load();
    if (!pf) {
      setStatus('Search works on the built site. Run a build, then preview it.');
      return;
    }
    const options = activeType === 'All' ? {} : { filters: { type: activeType } };
    const found = await pf.debouncedSearch(query, options, 150);
    if (!found || id !== latest) return;
    const totals = found.totalFilters?.type;
    const counts = totals && Object.keys(totals).length ? totals : (found.filters?.type ?? {});
    if (activeType !== 'All' && !counts[activeType]) {
      activeType = 'All';
      run();
      return;
    }
    const all = await Promise.all(found.results.slice(0, 24).map((r) => r.data()));
    const kindOf = (d: Data) => d.meta.kind ?? 'page';
    const items =
      activeType === 'All'
        ? all.sort((x, y) => Number(kindOf(x) !== 'page') - Number(kindOf(y) !== 'page')).slice(0, 8)
        : all;
    if (id !== latest) return;
    renderTypes(counts);
    render(items, query);
  };

  const renderTypes = (counts: Record<string, number>) => {
    if (!typesEl) return;
    const total = TYPES.reduce((sum, type) => sum + (counts[type] ?? 0), 0);
    const present = TYPES.filter((type) => counts[type]);
    if (present.length < 2) {
      typesEl.hidden = true;
      typesEl.replaceChildren();
      return;
    }
    typesEl.hidden = false;
    typesEl.replaceChildren(
      ...[['All', total] as const, ...present.map((type) => [type, counts[type]] as const)].map(([type, count]) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'search__pill';
        button.dataset.type = type;
        button.setAttribute('aria-pressed', String(type === activeType));
        button.textContent = `${type} ${count}`;
        return button;
      }),
    );
  };

  typesEl?.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-type]');
    if (!pill) return;
    activeType = pill.dataset.type ?? 'All';
    run();
  });

  const open = () => {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    input?.select();
    load();
    if (unavailable) setStatus('Search works on the built site. Run a build, then preview it.');
  };
  const close = () => dialog?.close();

  document.querySelectorAll('[data-search-open]').forEach((el) => el.addEventListener('click', open));
  document.querySelectorAll('[data-search-close]').forEach((el) => el.addEventListener('click', close));

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (dialog?.open) close();
      else open();
    }
  });

  input?.addEventListener('input', run);

  dialog?.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('a');
    if (e.target === dialog) close();
    else if (link) {
      track('site_search_result_click', { query: lastQuery, url: link.getAttribute('href'), position: links().indexOf(link) + 1 });
      close();
    }
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      links()[active]?.click();
    }
  });

  list?.addEventListener('mousemove', (e) => {
    const link = (e.target as HTMLElement).closest('a');
    if (link) setActive(links().indexOf(link));
  });
</script>

<style is:global>
  .search {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(80dvh, 44rem);
    margin: 10dvh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
    overflow: hidden;
  }
  .search[open] {
    display: flex;
    flex-direction: column;
  }
  .search::backdrop {
    background: rgb(11 31 42 / 0.55);
  }
  .search__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem 0.5rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .search__icon {
    flex: none;
    color: var(--ink);
  }
  .search__input {
    flex: 1;
    min-width: 0;
    height: 3rem;
    border: 0;
    background: none;
    font: inherit;
    font-size: 1.0625rem;
    color: var(--ink);
  }
  .search__input:focus {
    outline: none;
  }
  .search__input::-webkit-search-cancel-button {
    display: none;
  }
  .search__close {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .search__close:hover {
    background: var(--tint-2);
  }
  .search__types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem 0;
  }
  .search__types[hidden] {
    display: none;
  }
  .search__pill {
    padding: 0.125rem 0.875rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
    cursor: pointer;
  }
  .search__pill:hover {
    border-color: var(--brand);
  }
  .search__pill[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }
  .search__status {
    margin: 0;
    padding: 0.75rem 1.25rem 0;
    color: var(--text);
    font-size: 1rem;
  }
  .search__status:empty {
    display: none;
  }
  .search__results {
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    overflow-y: auto;
  }
  .search__results:empty {
    display: none;
  }
  .search__results a {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .search__results a.is-active,
  .search__results a:focus-visible {
    background: var(--tint);
  }
  .search__body {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    min-width: 0;
  }
  .search__tag {
    flex: none;
    padding: 0.125rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .search__title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .search__section {
    color: var(--blue-700);
    font-size: 1rem;
    font-weight: 600;
  }
  .search__excerpt {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.4;
  }
  .search__excerpt mark {
    background: var(--tint);
    color: var(--ink);
    border-radius: 0.2rem;
  }
  html:has(#search-dialog[open]) {
    overflow: hidden;
  }
</style>
