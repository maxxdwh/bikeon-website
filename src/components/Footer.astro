---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-white-long.svg';
import { guideLinks, quickLinks, socialLinks } from '../data/nav';
const year = new Date().getFullYear();
const siteLinks = quickLinks.filter((link) => link.href !== '/');
---

<footer class="site-footer">
  <div class="container-page inner">
    <div class="cols">
      <div class="about">
        <a class="brand" href="/">
          <Image src={logo} alt="Bikes in Schools" width={178} height={28} layout="fixed" class="h-7 w-auto" />
        </a>
        <p>
          A charitable trust helping schools across New Zealand give every student the chance to ride a bike at school.
        </p>
      </div>

      <nav aria-label="Guide">
        <p class="heading">Explore the guide</p>
        <ul class="two-col">
          {guideLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Site">
        <p class="heading">Site</p>
        <ul>
          {siteLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="base">
      <p>
        &copy; Bike On New Zealand Charitable Trust (CC44779) 2010&ndash;{year}
      </p>
      <ul class="social">
        {socialLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--on-dark-muted);
    font-size: 1rem;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 3.5rem 3rem;
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 3rem;
  }
  .cols > * {
    flex: 1 1 14rem;
    min-width: 0;
  }
  .about {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 22rem;
  }
  .about p {
    text-wrap: balance;
  }
  .heading {
    margin-bottom: 0.5rem;
    font-weight: 700;
    color: #fff;
  }
  ul {
    padding: 0;
    list-style: none;
  }
  .two-col {
    columns: 2 8rem;
    column-gap: 1.5rem;
  }
  a {
    display: inline-block;
    padding-block: 0.375rem;
    color: #fff;
    text-decoration: none;
  }
  a:hover {
    color: var(--brand);
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink-2);
  }
  .social {
    display: flex;
    gap: 1.5rem;
  }
</style>
